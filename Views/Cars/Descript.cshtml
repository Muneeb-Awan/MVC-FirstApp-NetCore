@model MyWebApp.Models.Cars;
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{

}

<table class="car-table" border="1" cellpadding="5" cellspacing="0">
    <thead>
        <tr>
            <th>Properties</th>
            <th>Values</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><b>Car Name:</b></td>
            <td>@Model.Name</td>
        </tr>
        <tr>
            <td><b>Car Color:</b></td>
            <td>@Model.color</td>
        </tr>
        <tr>
            <td><b>Description:</b></td>
            <td>@Model.description</td>
        </tr>
        <tr>
            <td><b>Model Number:</b></td>
            <td>@Model.modelNumber</td>
        </tr>
        <tr>
            <td><b>Fuel Type:</b></td>
            <td>@Model.fuletype</td>
        </tr>
    </tbody>
</table>
<style>
    body {
        background-image: url(@Model.imageURL); /* Change to your image path */
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center center;
        background-attachment: fixed;
        font-family: 'Segoe UI', sans-serif;
    }
</style>